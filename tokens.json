{
  "$description": "Versable Design System v1 - source tokens. Values are grounded in supplied brand assets; semantic aliases are the implementation contract.",
  "color": {
    "primitive": {
      "navy": { "900": "#17295F", "700": "#45547F", "100": "#D2D5DF" },
      "turquoise": { "600": "#008F86", "500": "#00AFA3", "400": "#00CBBD", "100": "#CEE8E7" },
      "vermilion": { "700": "#C72B12", "600": "#D9381E", "500": "#FF3200", "200": "#F6B6A4" },
      "grey": { "800": "#4E4D46", "600": "#6D6B62", "500": "#8A887D", "200": "#E2E2E2", "100": "#F5F5F3" },
      "white": "#FFFFFF", "black": "#1A1A18",
      "status": { "success": "#25834B", "warning": "#9A6200", "danger": "#C72B12", "info": "#1B5F9A" }
    },
    "background": { "primary": "{color.primitive.white}", "secondary": "{color.primitive.grey.100}", "brand": "{color.primitive.navy.900}", "inverse": "{color.primitive.navy.900}" },
    "surface": { "default": "{color.primitive.white}", "subtle": "{color.primitive.grey.100}", "selected": "{color.primitive.navy.100}", "inverse": "{color.primitive.navy.900}" },
    "text": { "primary": "{color.primitive.black}", "secondary": "{color.primitive.grey.600}", "link": "{color.primitive.navy.900}", "inverse": "{color.primitive.white}", "brand": "{color.primitive.navy.900}" },
    "border": { "default": "{color.primitive.grey.200}", "strong": "{color.primitive.grey.500}", "interactive": "{color.primitive.navy.900}" },
    "action": { "primary": { "default": "{color.primitive.navy.900}", "hover": "#0E1D46", "active": "#091431", "text": "{color.primitive.white}" }, "secondary": { "default": "{color.primitive.turquoise.400}", "hover": "{color.primitive.turquoise.500}", "text": "{color.primitive.navy.900}" }, "danger": { "default": "{color.primitive.vermilion.700}", "hover": "#A8200C", "text": "{color.primitive.white}" } },
    "feedback": { "success": "{color.primitive.status.success}", "warning": "{color.primitive.status.warning}", "danger": "{color.primitive.status.danger}", "info": "{color.primitive.status.info}" },
    "focus": "{color.primitive.turquoise.600}",
    "dark": { "background": "{color.primitive.navy.900}", "surface": "#20386F", "text": "{color.primitive.white}", "textMuted": "{color.primitive.navy.100}", "border": "#7282A8" }
  },
  "font": { "family": { "interface": "Montserrat, Arial, sans-serif", "display": "Benton Modern Display Compact, Georgia, serif", "mono": "ui-monospace, SFMono-Regular, Menlo, monospace" }, "weight": { "light": 300, "regular": 400, "medium": 500, "bold": 700 } },
  "type": { "display": { "size": "clamp(2.6rem, 5vw, 5.25rem)", "lineHeight": 0.95, "weight": 400, "letterSpacing": "-0.035em" }, "heading": { "1": { "size": "2.25rem", "lineHeight": 1.08, "weight": 700 }, "2": { "size": "1.5rem", "lineHeight": 1.18, "weight": 700 }, "3": { "size": "1.125rem", "lineHeight": 1.3, "weight": 700 } }, "body": { "default": { "size": "1rem", "lineHeight": 1.6, "weight": 400 }, "small": { "size": "0.875rem", "lineHeight": 1.5, "weight": 400 } }, "label": { "default": { "size": "0.75rem", "lineHeight": 1.3, "weight": 700, "letterSpacing": "0.06em" } }, "data": { "size": "0.875rem", "lineHeight": 1.35, "weight": 500, "fontVariantNumeric": "tabular-nums" } },
  "space": { "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.5rem", "6": "2rem", "7": "3rem", "8": "4.5rem", "9": "6rem" },
  "radius": { "none": "0", "small": "0.25rem", "medium": "0.5rem", "large": "0.75rem", "round": "999px" },
  "border": { "width": { "hairline": "1px", "strong": "2px" } },
  "elevation": { "none": "none", "raised": "0 2px 8px rgba(23, 41, 95, 0.12)", "overlay": "0 18px 42px rgba(9, 20, 49, 0.2)" },
  "motion": { "duration": { "fast": "120ms", "standard": "180ms", "slow": "280ms" }, "ease": { "standard": "cubic-bezier(0.2, 0, 0, 1)" } },
  "layout": { "content": { "reading": "44rem", "standard": "75rem", "wide": "90rem" }, "breakpoint": { "sm": "40rem", "md": "64rem", "lg": "80rem" }, "gutter": { "mobile": "1rem", "desktop": "2rem" }, "target": { "minimum": "2.75rem" } }
}
